rules_version = '2';

// 진짜 Firebase에 배포되는 규칙. Firebase 콘솔에 넣어 둔 규칙과 같게 유지한다.
// 2026-12-14까지는 누구나, 그 뒤로는 로그인한 사람만 읽고 쓸 수 있다.
// 로컬 에뮬레이터는 firebase.emulator.json 으로 firestore.dev.rules 를 쓴다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 14) || request.auth != null;
    }
  }
}
